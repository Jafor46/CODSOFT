import java.util.Scanner;

public class StudentGradeCalculator {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        System.out.print("Enter the number of subjects: ");
        int numSubjects = scanner.nextInt();
        
        double[] marks = new double[numSubjects+1];
        double totalMarks = 0;
        
        for (int i = 1; i <= numSubjects; i++) {
            System.out.print("Enter marks obtained in subject " + i + " (out of 100): ");
            marks[i] = scanner.nextInt();
            totalMarks += marks[i];
        }
        
        double StudentPercentage =totalMarks / numSubjects;
        String grade;
        
        if (StudentPercentage >= 80) {
            grade = "A+";
        } else if (StudentPercentage >= 70) {
            grade = "A";
        } else if (StudentPercentage >= 60) {
            grade = "A-";
        } else if (StudentPercentage >= 50) {
            grade = "B";
        }else if (StudentPercentage >= 40) {
            grade = "C";
        }else if (StudentPercentage >= 33) {
            grade = "D";
        } else {
            grade = "F";
        }
        
        System.out.println("Total_Marks: " + totalMarks);
        System.out.println("Average Percentage: " + StudentPercentage + "%");
        System.out.println("Grade: " + grade);
        
        scanner.close();
    }
}
