
import java.util.Random;
import java.util.Scanner;

public class NumberGuessGame {
	public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Random random = new Random();
        
        long guessNumber, startingRange, endingRange;
        
        System.out.print("Enter the Starting Range: ");
        startingRange = scanner.nextLong();
        
        System.out.print("Enter the Ending Range: ");
        endingRange = scanner.nextLong();
        
        if (startingRange >= endingRange) {
            System.out.println("Range is Invalid");
            scanner.close();
            return;
        }
        
        long randomNumber = startingRange + (random.nextLong() % (endingRange - startingRange + 1));
        
        while (true) {
            System.out.print("Enter your guess: ");
            guessNumber = scanner.nextLong();
            
            if (guessNumber < randomNumber) {
                System.out.println("The Guess Number is too Low.");
            } else if (guessNumber > randomNumber) {
                System.out.println("The Guess Number is too High.");
            } else {
                System.out.println("Congratulations! Your Guess Number matched the Random Number.");
                break;
            }
        }
        
        scanner.close();
    }
}

